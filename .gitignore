# ---------------------------------------------------------------
# GO-GO Ride - what never goes to GitHub
# ---------------------------------------------------------------

# Secrets and machine-specific settings
.env
.env.local
.env.*.local
local.properties
*.keystore
*.jks

# Live data: user accounts, bookings, uploaded documents and photos
backend-python/gogoride.db
backend-python/*.db-journal
backend-python/uploads/

# Dependencies and build output
node_modules/
dist/
.build-check/
__pycache__/
*.pyc
.venv/
*.log

# Android build output and generated files
go-go-ride apk/android/.gradle/
go-go-ride apk/android/build/
go-go-ride apk/android/app/build/
go-go-ride apk/android/capacitor-cordova-android-plugins/build/
go-go-ride apk/android/app/src/main/assets/public/
*.apk
!backend-node/public/downloads/GO-GO-Ride.apk
*.aab

# Large local tools and generated packages
android-studio-*/
android-studio-*.exe
deploy-hostinger/build/
deploy-hostinger/gogoride-deploy.zip

# Editor / assistant state
.claude/
.idea/
.vscode/
Thumbs.db
.DS_Store

# Node API: local data, starter database (contains user accounts), local settings
backend-node/data/
backend-node/seed/*.db
backend-node/seed/uploads/
deploy-hostinger-cloud/production-secrets.txt
deploy-hostinger-cloud/gogoride-api.zip
deploy-hostinger-cloud/build/
# (the release APK + app-info.json in backend-node/public/downloads ARE committed:
#  Hostinger auto-deploys from GitHub and the download page serves them)

# Android release signing key (private - back up separately)
go-go-ride apk/android/keystore.properties
go-go-ride apk/android/keystore/

# Hostinger data backups (users, bookings) - never push
gogoride-data*.zip
backups/
