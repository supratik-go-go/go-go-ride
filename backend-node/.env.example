# ---------------------------------------------------------------
# GO-GO Ride API (Node) settings. Copy to .env for local runs.
# On Hostinger set these as the Node.js app's Environment Variables.
# ---------------------------------------------------------------

ENVIRONMENT=development
PORT=8000

# Website/app origins allowed to call the API (comma separated).
# The Android app (Capacitor) calls from https://localhost.
CORS_ORIGINS=https://localhost,capacitor://localhost,http://localhost:5173,http://localhost:5174

# SQLite database file. On Hostinger put it OUTSIDE the app folder (deployments
# overwrite the app folder), e.g. /home/<user>/gogoride-data/gogoride.db
DATABASE_PATH=./data/gogoride.db
# Copied to DATABASE_PATH on first start when that file does not exist yet.
STARTER_DATABASE=./seed/gogoride.db

# Uploaded bus documents / photos. Also keep OUTSIDE the app folder on Hostinger.
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=5

# Long random strings in production (e.g. openssl rand -hex 32).
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# OTP codes are returned as data.devCode only in development.
OTP_DEV_ECHO=true
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Owners must declare a non-operating date at least this many days ahead.
BUS_EXCEPTION_MIN_DAYS=5

# Secret for GET /api/internal/run-alarms?key=... (hPanel cron backup for the
# in-process alarm timer). Leave empty to disable that endpoint.
CRON_KEY=
