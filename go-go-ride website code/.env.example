# ---------------------------------------------------------------
# GO-GO Ride frontend configuration. Copy to .env and edit.
# ---------------------------------------------------------------

# Where the API lives.
#  - Leave EMPTY for local development: Vite proxies /api and /uploads to
#    BACKEND_ORIGIN below, so no CORS setup is needed.
#  - Set it to the full public URL for production builds and for the
#    Android / Play Store app, e.g. https://api.gogoride.in/api
#    (a phone cannot reach "localhost" on your computer).
VITE_API_URL=

# Backend used by the dev-server proxy (only when VITE_API_URL is empty).
BACKEND_ORIGIN=http://localhost:8000

# Live-tracking position refresh interval, in milliseconds.
VITE_TRACKING_REFRESH_MS=5000
